# ==============================================================================
# NEAR Guard Configuration (ALL SETTINGS ARE OPTIONAL)
# Copy to .env only if you want to customize defaults or test live Testnet signing.
# Without a .env file, NEAR Guard queries live NEAR public RPC + NearBlocks v3 +
# FastNEAR read-only endpoints and runs AgentGuardWallet in zero-secret local
# Function-Call Key signing verification mode.
# ==============================================================================

# Server port for Express API (and built static UI)
PORT=3001

# Default NEAR network for counterparty checks and wallet posture: testnet | mainnet
NEAR_NETWORK=testnet

# Scoped router/vault contract that the agent's Function-Call key is allowed to call.
# An autonomous agent MUST NEVER hold a Full-Access key.
SCOPED_CONTRACT_ID=guest-book.testnet

# Allowed method names on SCOPED_CONTRACT_ID (comma-separated)
SCOPED_METHOD_NAMES=addMessage,pay_counterparty,route_payment

# Gas allowance cap for the scoped Function-Call key (in NEAR)
AGENT_KEY_ALLOWANCE_NEAR=0.25

# Optional: Live NEAR Testnet broadcast mode (leave blank for safe local Borsh signing)
# NOTE: AgentGuardWallet verifies this key via NEAR RPC `view_access_key` and
# REFUSES TO RUN if the key has FullAccess permissions!
AGENT_ACCOUNT_ID=
AGENT_FUNCTION_CALL_KEY=

# Optional: NEAR AI Cloud private TEE inference for semantic prompt-injection analysis
# Claim $10 free credits at https://nearbuilders.org/dashboard or https://cloud.near.ai
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
